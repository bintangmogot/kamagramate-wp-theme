{
    "key": "group_wa_sitemap_settings",
    "title": "Waklert Sitemap Settings",
    "fields": [
        {
            "key": "field_wa_sitemap_title",
            "label": "Sitemap Title",
            "name": "sitemap_title",
            "type": "text",
            "default_value": "Site Map"
        },
        {
            "key": "field_wa_sitemap_intro",
            "label": "Introductory Text",
            "name": "sitemap_intro",
            "type": "textarea",
            "default_value": "Browse the main pages, armodafinil products and support information on this site."
        },
        {
            "key": "field_wa_sitemap_columns",
            "label": "Sitemap Columns",
            "name": "sitemap_columns",
            "type": "repeater",
            "instructions": "Add columns and links here. Leave this empty to generate the sitemap from published site content.",
            "collapsed": "field_wa_sitemap_column_title",
            "layout": "block",
            "button_label": "Add Column",
            "sub_fields": [
                {
                    "key": "field_wa_sitemap_column_title",
                    "label": "Column Title",
                    "name": "column_title",
                    "type": "text",
                    "required": 1
                },
                {
                    "key": "field_wa_sitemap_links",
                    "label": "Links",
                    "name": "links",
                    "type": "repeater",
                    "layout": "table",
                    "button_label": "Add Link",
                    "sub_fields": [
                        {
                            "key": "field_wa_sitemap_link",
                            "label": "Link",
                            "name": "link",
                            "type": "link",
                            "required": 1
                        }
                    ]
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "page_template",
                "operator": "==",
                "value": "page-sitemap.php"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "hide_on_screen": "",
    "active": true,
    "description": ""
}
